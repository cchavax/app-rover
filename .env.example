# Copiá este archivo como .env.local y completá los valores.
# Solo van claves PÚBLICAS: todo lo que empieza con VITE_ termina en el navegador.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clave pública VAPID para notificaciones push (paso 4)
VITE_VAPID_PUBLIC_KEY=

# NUNCA pongas acá la service_role key ni la clave privada VAPID.
