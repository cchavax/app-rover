{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/a/:id", "destination": "/api/preview?t=a&id=:id" },
    { "source": "/p/:id", "destination": "/api/preview?t=p&id=:id" },
    { "source": "/((?!api/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
